# Windows stack build output. FFmpeg is fetched and checksum verified.
**/target/
winui/**/bin/
winui/**/obj/
.vs/
*.user
DvlErrLog.txt

# Prebuilt/release output — produced by CI, never committed
dist/

# devcon.exe is obtained from the WDK by CI.
installer/tools/devcon.exe

# Required sources otherwise matched by inherited Android/Python ignore rules.
!winui/NTPods.WinUI/app.manifest
!installer/msi/build-msi.ps1

# Driver build output (local WDK builds; CI builds its own)
drivers/**/x64/
drivers/mic-portcls/x64/
# The mic driver package is built by CI, never committed
drivers/mic-portcls/prebuilt/
