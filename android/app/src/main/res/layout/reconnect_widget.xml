<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reconnect_widget_button"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="8dp"
    android:background="@drawable/reconnect_widget_background"
    android:contentDescription="@string/reconnect_widget_description">
    <ImageView android:layout_width="32dp" android:layout_height="32dp"
        android:src="@drawable/reconnect_widget_icon" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/reconnect_widget_label"
        android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"
        android:maxLines="2" />
</LinearLayout>
