<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/airpods_row_background">
    <LinearLayout android:id="@+id/row_battery_group" android:layout_width="96dp"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="AirPods" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/row_battery_buds" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="L — · R —" android:textColor="#E5E5EA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/row_battery_case" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Case —" android:textColor="#AEAEB2" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_transparency" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="52dp" android:layout_marginEnd="3dp" android:orientation="vertical"
        android:gravity="center" android:background="@drawable/airpods_row_button" android:contentDescription="@string/qs_airpods_transparency">
        <ImageView android:id="@+id/row_transparency_icon" android:layout_width="23dp" android:layout_height="23dp"
            android:src="@drawable/transparency" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/row_transparency_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/row_hear" android:textSize="9sp" android:textColor="#FFFFFF"
            android:maxLines="1" android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_cancellation" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="52dp" android:layout_marginEnd="3dp" android:orientation="vertical"
        android:gravity="center" android:background="@drawable/airpods_row_button" android:contentDescription="@string/qs_airpods_cancellation">
        <ImageView android:id="@+id/row_cancellation_icon" android:layout_width="23dp" android:layout_height="23dp"
            android:src="@drawable/noise_cancellation" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/row_cancellation_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/row_anc" android:textSize="9sp" android:textColor="#FFFFFF"
            android:maxLines="1" android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_adaptive" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="52dp" android:layout_marginEnd="3dp" android:orientation="vertical"
        android:gravity="center" android:background="@drawable/airpods_row_button" android:contentDescription="@string/qs_airpods_adaptive">
        <ImageView android:id="@+id/row_adaptive_icon" android:layout_width="23dp" android:layout_height="23dp"
            android:src="@drawable/adaptive" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/row_adaptive_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/row_auto" android:textSize="9sp" android:textColor="#FFFFFF"
            android:maxLines="1" android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_off" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="52dp" android:layout_marginEnd="3dp" android:orientation="vertical"
        android:gravity="center" android:background="@drawable/airpods_row_button" android:contentDescription="@string/qs_airpods_off">
        <ImageView android:id="@+id/row_off_icon" android:layout_width="23dp" android:layout_height="23dp"
            android:src="@drawable/airpods_row_off" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/row_off_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/qs_airpods_off" android:textSize="9sp" android:textColor="#FFFFFF"
            android:maxLines="1" android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_reconnect" android:layout_width="44dp" android:layout_height="52dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/airpods_row_button"
        android:contentDescription="@string/reconnect_widget_description">
        <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/reconnect_widget_icon"
            android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:text="@string/row_connect" android:textSize="9sp" android:textColor="#FFFFFF" android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
