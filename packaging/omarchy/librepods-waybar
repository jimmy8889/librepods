#!/usr/bin/env python3
"""Convert local IPC notifications to Waybar JSON without battery polling."""
import html
import json
import subprocess


def format_status(state):
    if not state.get("connected"):
        return {"text": "AirPods", "class": "disconnected", "tooltip": "AirPods disconnected"}
    levels = [f"{label} {state[key]}%" for key, label in
              (("left", "L"), ("right", "R"), ("case", "C"), ("headset", "B"))
              if state.get(key) is not None]
    modes = ("Off", "ANC", "Transparency", "Adaptive")
    mode = state.get("noise_mode")
    name = html.escape(state.get("name") or "AirPods")
    text = " · ".join(levels) or "AirPods"
    tooltip = name + "\n" + text
    if isinstance(mode, int) and 0 <= mode < len(modes):
        tooltip += "\n" + modes[mode]
    return {"text": text, "class": "connected", "tooltip": tooltip}


def main():
    try:
        with subprocess.Popen(["librepods-ctl", "watch"], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True) as child:
            for line in child.stdout:
                try:
                    print(json.dumps(format_status(json.loads(line))), flush=True)
                except (ValueError, TypeError, KeyError):
                    continue
    except FileNotFoundError:
        pass
    print(json.dumps({"text": "AirPods", "class": "unavailable",
                      "tooltip": "Start LibrePods to connect"}), flush=True)


if __name__ == "__main__":
    main()
